# ==============================================================================
# Caddyfile — VisualVibe Electron reverse proxy
# ==============================================================================
# Multi-listener architecture:
#   :80   — Plain HTTP redirect to HTTPS (preserves host & URI)
#   :443  — HTTPS via persistent self-signed certificate with IP SANs
#   :8000 — Plain HTTP (no TLS, no redirect) for upstream reverse proxies (Cloudflare, etc.)
#
# Direct IP access in browsers requires a Secure Context (window.isSecureContext)
# for clipboard, service workers, and modern Web APIs.
# Serving HTTPS enables Secure Context for all clients (hostname and direct raw IP).
#
# Backend routes:
#   /filebrowser/* → FileBrowser Quantum on 127.0.0.1:8081 (prefix preserved)
#   /*             → KasmVNC Web / WebSocket on 127.0.0.1:8444
# ==============================================================================

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /home/vvelectron/.config/caddy/certs/cert.pem /home/vvelectron/.config/caddy/certs/key.pem

	# Compression for static assets (disabled on WebSocket streaming).
	encode zstd gzip

	# Baseline security headers (perimeter security model: auth is enforced upstream).
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Redirect bare /filebrowser → /filebrowser/ (Caddy-side convenience redirect)
	redir /filebrowser /filebrowser/ permanent

	# Direct Favicon routes for browser tab & bookmarks
	handle /favicon.ico {
		rewrite * /favicon.ico
		root * /opt/visualvibe/media
		file_server
	}

	handle /favicon.svg {
		rewrite * /favicon.svg
		root * /opt/visualvibe/media
		file_server
	}

	handle /apple-touch-icon.png {
		rewrite * /apple-touch-icon.png
		root * /opt/visualvibe/media
		file_server
	}

	# FileBrowser Quantum custom branding
	handle /filebrowser/public/static/favicon.svg {
		rewrite * /favicon.svg
		root * /opt/visualvibe/media
		file_server
	}

	handle /filebrowser/public/static/site.webmanifest {
		header Content-Type application/manifest+json
		rewrite * /filebrowser.webmanifest
		root * /opt/visualvibe/config
		file_server
	}

	handle /filebrowser/public/static/img/icons/* {
		uri strip_prefix /filebrowser/public/static/img/icons
		root * /opt/visualvibe/media
		file_server
	}

	# FileBrowser application route
	handle /filebrowser/* {
		reverse_proxy 127.0.0.1:8081
	}

	# KasmVNC Desktop Web & WebSocket route (root fallback)
	handle {
		reverse_proxy 127.0.0.1:8444 {
			flush_interval -1
		}
	}
}

:8000 {
	# Compression for static assets
	encode zstd gzip

	# Baseline security headers
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Redirect bare /filebrowser → /filebrowser/
	redir /filebrowser /filebrowser/ permanent

	# Direct Favicon routes for browser tab & bookmarks
	handle /favicon.ico {
		rewrite * /favicon.ico
		root * /opt/visualvibe/media
		file_server
	}

	handle /favicon.svg {
		rewrite * /favicon.svg
		root * /opt/visualvibe/media
		file_server
	}

	handle /apple-touch-icon.png {
		rewrite * /apple-touch-icon.png
		root * /opt/visualvibe/media
		file_server
	}

	# FileBrowser Quantum custom branding
	handle /filebrowser/public/static/favicon.svg {
		rewrite * /favicon.svg
		root * /opt/visualvibe/media
		file_server
	}

	handle /filebrowser/public/static/site.webmanifest {
		header Content-Type application/manifest+json
		rewrite * /filebrowser.webmanifest
		root * /opt/visualvibe/config
		file_server
	}

	handle /filebrowser/public/static/img/icons/* {
		uri strip_prefix /filebrowser/public/static/img/icons
		root * /opt/visualvibe/media
		file_server
	}

	# FileBrowser application route
	handle /filebrowser/* {
		reverse_proxy 127.0.0.1:8081
	}

	# KasmVNC Desktop Web & WebSocket route (root fallback)
	handle {
		reverse_proxy 127.0.0.1:8444 {
			flush_interval -1
		}
	}
}
