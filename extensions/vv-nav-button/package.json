{
  "name": "vv-nav-button",
  "displayName": "VisualVibe Navigator",
  "description": "Adds FileBrowser navigation to Activity Bar",
  "version": "1.0.0",
  "publisher": "visualvibe",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:visualvibe.filebrowser"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualvibe-nav",
          "title": "VisualVibe FileBrowser",
          "icon": "media/folder.svg"
        }
      ]
    },
    "views": {
      "visualvibe-nav": [
        {
          "type": "webview",
          "id": "visualvibe.filebrowser",
          "name": "VisualVibe FileBrowser"
        }
      ]
    }
  },
  "categories": [
    "Other"
  ]
}
