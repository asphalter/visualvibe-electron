[Unit]
Description=VisualVibe Electron — AI-powered Remote Desktop IDE
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/visualvibe-electron:latest
ContainerName=visualvibe-electron

# --- Network ---
PublishPort=80:80
PublishPort=443:443
PublishPort=8000:8000

# --- Podman-in-Podman requires privileged mode ---
PodmanArgs=--privileged

# --- Resource allocation ---
ShmSize=2g

# --- AI Agent Configuration (MANDATORY) ---
# IMPORTANT: fill the three values below BEFORE enabling this unit — the container
# aborts startup if any of them is empty.
# URL of the external AI API endpoint (OpenAI-Compatible, e.g. OmniRoute)
Environment=AI_API_URL=

# API Key for the external AI endpoint
Environment=AI_API_KEY=

# Preferred language for Zoo Code (e.g. it, en, es, fr, de, etc.)
Environment=AI_LANG=

# --- Custom TLS Certificate (OPTIONAL) ---
# Both CERTFILE_PUBLIC and CERTFILE_PRIVATE must be provided for custom TLS to be deployed.
# If omitted or only one is set, VisualVibe falls back to persistent self-signed TLS with IP SANs.
# Supported formats: path to container file (e.g. via volume), raw PEM content, or base64 string.
# Environment=CERTFILE_PUBLIC=/certs/fullchain.pem
# Environment=CERTFILE_PRIVATE=/certs/privkey.pem

# --- Persistent volume for /home/vvelectron ---
Volume=visualvibe-home.volume:/home/vvelectron

# --- Health check (verifies both KasmVNC root and FileBrowser via Caddy) ---
HealthCmd=curl -fsSko /dev/null https://localhost/ && curl -fsSko /dev/null https://localhost/filebrowser/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=default.target
